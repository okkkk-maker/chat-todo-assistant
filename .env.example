# 待办自动汇总助手 · 统一多平台环境配置文件
# 可由 Web_Console.bat / Start.bat 打开可视化监控台一键配置，或由 Admin_Init.bat 引导生成。
# 注意：首次使用前请在控制台【系统设置】中确认配置模式与启用平台；飞书与钉钉尚未经过实机测试。
# 各平台具体怎么开通，见 docs/专题指引/全平台接入指南.md

# ==================== [必填基底] 腾讯 QQ 通道 ====================
# 锁定的主 QQ 号（纯数字 UIN）
QQ_TARGET_UIN=
# 该 QQ 的消息库绝对路径，形如 E:\Tencent Files\<QQ号>\nt_qq\nt_db\nt_msg.db
QQ_DB_PATH=
# QQ 数据库密钥：16 位 ASCII 口令
QQ_DBKEY=
# 解密参数组合：profile_1 / profile_2 / profile_3
QQ_CIPHER_PROFILE=

# ==================== [可选扩展] 个人微信通道（本地加密库直读） ====================
# 64 位十六进制 raw key，由控制台「自动抓取」或 vendor/2-get-wechat-key.bat 提取。
# 取到后程序会**先用 page1 校验**再写入：密钥不对不会被存进来。
WX_DBKEY=
# 自定义 db_storage 所在根目录。可填三种写法之一：xwechat_files 根 / <wxid>_xxx / db_storage
# 不填则自动扫描 Documents\xwechat_files、文档\xwechat_files、OneDrive、各盘 WeChat Files
WX_DATA_PATH=
# 是否允许"扫描微信进程内存"取密钥（1 允许 / 0 禁止）。禁止后只能用 .env 或粘贴的密钥
WX_ALLOW_SCAN=1
# 单轮内存扫描的时长上限（秒）。越大越可能等到微信把密钥写回内存
WX_SCAN_SECONDS=25
# 明文镜像落地目录（默认 work\wx_mirror；想放到别的盘就填绝对路径）
# WX_MIRROR_DIR=E:\todo\wx_mirror
# 一次性人工粘贴的密钥（留空则忽略；粘贴后会校验再写入 WX_DBKEY）
# WX_DBKEY_MANUAL=

# ==================== [可选扩展] 飞书通道（Open API 主动拉取） ====================
# 飞书开放平台 → 自建应用 → 凭证与基础信息
# 必开权限：im:message:readonly、im:chat:readonly；且应用必须被拉进要读的群
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 单轮最多遍历多少个会话（群多就调大，越大越慢；默认 60）
FEISHU_MAX_CHATS=60
# 可选：open_id → 人名映射（没有通讯录权限时用它把发送人显示成人名）
# FEISHU_SENDER_MAP={"ou_xxxxxxxx":"王主任"}
# 可选：私有化部署/联调用的接口根地址（默认 https://open.feishu.cn）
# FEISHU_BASE_URL=https://open.feishu.cn

# ==================== [收件箱模式] 钉钉通道 ====================
# 钉钉没有"读所有群消息"的开放接口，必须由「会话内容存档」或「机器人回调」
# 拉到消息后写进 work/inbox/dingtalk.jsonl（见 docs/专题指引/全平台接入指南.md 第 5 节）
# 注意：钉钉通道尚未经过实机测试，启用前需先在【系统设置】中确认勾选与配置
# 拿不到消息就请在监控台取消勾选钉钉，否则每轮都会提示"尚未接入"
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# ==================== [推送与调度参数] ====================
# 【可选】企业微信群机器人 Webhook（WorkBuddy 连接器失效时的备用兜底通道，只能发不能收）
WECOM_WEBHOOK_URL=
# 默认回看小时数（默认 4 小时）
SUMMARY_HOURS=4
